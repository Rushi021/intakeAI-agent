# ── Mistral AI access ───────────────────────────────────────────────────────
# This file is the ONLY way the extension gets an API key.
#
#   1. cp .env.example .env
#   2. paste your key below   (https://console.mistral.ai → API Keys)
#   3. npm run build          ← the key is read at BUILD time, not at run time
#
# Changing .env later does nothing until you re-run `npm run build` and press
# reload on the extension in chrome://extensions.
#
# The key is inlined into dist/ in plain text, so anyone holding the built
# extension can read it. .env and dist/ are both gitignored. Use a revocable
# key and rotate it when you are done.

VITE_MISTRAL_API_KEY=

# Optional. Defaults to mistral-large-latest.
# One of: mistral-large-latest, mistral-medium-latest, mistral-small-latest, open-mistral-nemo
VITE_MISTRAL_MODEL=
