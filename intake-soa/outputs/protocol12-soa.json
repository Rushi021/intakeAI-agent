        {
          "marker": "***",
          "text": "*** ASI and HRBS also serve as both screening and baseline measures, but will not be used as a basis for exclusion from study.",
          "page": 49,
          "verdict": "accept",
          "score": 6,
          "attach": "page-break-markers",
